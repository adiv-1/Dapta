# Dapta local configuration. Copy to .env; never commit real values.

# Controller security and state
DAPTA_ENV=development
DAPTA_CONTROL_TOKEN=
DAPTA_LEDGER_PATH=artifacts/dapta.sqlite3
DAPTA_ALLOWED_ORIGINS=http://localhost:5173
DAPTA_SEED_DEMO_DATA=true
DAPTA_REPOSITORY_URL=https://github.com/adiv-1/Dapta

# OpenRouter factory, evaluator, and live comparison models
OPENROUTER_API_KEY=
OPENROUTER_FACTORY_MODEL=moonshotai/kimi-k3
OPENROUTER_CRITIC_MODEL=openai/gpt-oss-120b
OPENROUTER_FRONTIER_MODEL_A=
OPENROUTER_FRONTIER_MODEL_B=
OPENROUTER_FRONTIER_REASONING_A=
OPENROUTER_FRONTIER_REASONING_B=xhigh
OPENROUTER_APP_URL=https://github.com/adiv-1/Dapta

# Workflow router
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Devin skill-integration stage
DEVIN_API_KEY=
DEVIN_ORGANIZATION_ID=
DEVIN_BASE_URL=https://api.devin.ai

# Hostinger model worker
DAPTA_QWEN_URL=http://model-worker:8001
DAPTA_QWEN_TOKEN=
QWEN_BASE_MODEL=Qwen/Qwen3-VL-8B-Instruct
QWEN_ADAPTER_REPO=adityave/dapta-lora-adapters
QWEN_ADAPTER_SUBFOLDER=nda-intake/qwen3-vl-8b-v1
QWEN_ATTN_IMPLEMENTATION=sdpa
QWEN_MAX_NEW_TOKENS=1200
HOSTINGER_GPU_TYPE=A100-80GB
HOSTINGER_GPU_HOURLY_COST_USD=

# Durable adapter registry
HF_TOKEN=
HF_ADAPTER_REPO=adityave/dapta-lora-adapters

# Base44 workspace access is local only. It never reaches the browser.
BASE_44_API_KEY=
BASE44_APP_ID=

# Sentry backend and browser telemetry
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.25
VITE_SENTRY_DSN=

# ASI:One registration credentials
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=

# Local frontend only. Omit in Base44 to use the private server function.
VITE_DAPTA_API_URL=/api
