# Dapta local configuration. Copy to .env; never commit real values.

# Controller security and state
DAPTA_ENV=development
DAPTA_CONTROL_TOKEN=
DAPTA_LEDGER_PATH=artifacts/dapta.sqlite3
DAPTA_ALLOWED_ORIGINS=http://localhost:5173
DAPTA_SEED_DEMO_DATA=true

# OpenRouter factory, evaluator, and live comparison models
OPENROUTER_API_KEY=
OPENROUTER_FACTORY_MODEL=moonshotai/kimi-k3
OPENROUTER_CRITIC_MODEL=openai/gpt-oss-120b
OPENROUTER_FRONTIER_MODEL_A=
OPENROUTER_FRONTIER_MODEL_B=
OPENROUTER_FRONTIER_REASONING_A=
OPENROUTER_FRONTIER_REASONING_B=xhigh
OPENROUTER_DATA_BUILDER_REASONING_EFFORT=high
OPENROUTER_APP_URL=https://github.com/adiv-1/Dapta

# Workflow router
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Devin skill-integration stage
DEVIN_API_KEY=
DEVIN_ORGANIZATION_ID=
DEVIN_BASE_URL=https://api.devin.ai

# RunPod model worker and in-place factory training
DAPTA_QWEN_URL=http://model-worker:8001
DAPTA_QWEN_TOKEN=
DAPTA_FACTORY_AUTOSTART=true
DAPTA_FACTORY_TRAINING_ENABLED=true
DAPTA_FACTORY_WORK_DIR=/workspace/dapta/artifacts/factory
DAPTA_FACTORY_MAX_JOB_COST_USD=5
DAPTA_FACTORY_MAX_TRAIN_HOURS=2
DAPTA_FACTORY_EPOCHS=2
DAPTA_FACTORY_MAX_LENGTH=4096
DAPTA_FACTORY_MAX_TRAIN_EXAMPLES=64
DAPTA_FACTORY_MAX_TEST_EXAMPLES=12
DAPTA_FACTORY_MAX_NEW_TOKENS=4096
DAPTA_MIN_LORA_LIFT=0.02
DAPTA_MIN_SCHEMA_PASS_RATE=0.80
QWEN_BASE_MODEL=Qwen/Qwen3-VL-8B-Instruct
QWEN_ADAPTER_REPO=adityave/dapta-lora-adapters
QWEN_ADAPTER_SUBFOLDER=nda-intake/qwen3-vl-8b-v1
QWEN_ATTN_IMPLEMENTATION=sdpa
QWEN_MAX_NEW_TOKENS=1200
RUNPOD_POD_ID=
RUNPOD_GPU_TYPE=RTX A40
RUNPOD_GPU_PLAN=RTX-A40-48GB
RUNPOD_GPU_HOURLY_COST_USD=0.59
RUNPOD_REGION=

# Durable adapter registry
HF_TOKEN=
HF_ADAPTER_REPO=adityave/dapta-lora-adapters

# Server-only Supabase factory mirror. A management token can discover the
# named project and resolve its secret at startup; prefer direct URL + secret
# for long-lived production deployments.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_API_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_NAME=dapta

# Base44 workspace access is local only. It never reaches the browser.
BASE_44_API_KEY=
BASE44_APP_ID=

# Sentry backend telemetry (controller and Qwen worker; on RunPod these go in runtime.env)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_POLL_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.25
# Browser telemetry. Vite reads env files from frontend/, not this file: export these in the
# shell that runs the build, or put them in frontend/.env.production.local.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Only for `python -m dapta.sentry_check --confirm` (a read-only token with event:read).
# The project id and API region are taken from SENTRY_DSN unless overridden.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_API_URL=

# ASI:One registration credentials
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=

# Local frontend only. Omit in Base44 to use the private server function.
VITE_DAPTA_API_URL=/api
