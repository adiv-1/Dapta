# Dapta local configuration
# Copy this file to .env and fill values locally. Never commit real secrets.

# Required for the open-weight factory agents (Kimi K3 and optional OSS critic).
OPENROUTER_API_KEY=
OPENROUTER_FACTORY_MODEL=moonshotai/kimi-k3
OPENROUTER_CRITIC_MODEL=openai/gpt-oss-120b
OPENROUTER_APP_URL=https://github.com/adiv-1/Dapta

# Required for adapter routing decisions.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Required to provision, inspect, and destroy Vultr GPU instances.
# This is the normal API key for the same Vultr account that owns the credits.
VULTR_API_KEY=
VULTR_REGION=ewr
VULTR_GPU_PLAN_ID=vcg-a16-6c-60g-16vram
VULTR_OS_ID=1743
VULTR_SSH_KEY_ID=
VULTR_SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# The worker refuses changed pricing, duplicate workers, or a projected cost over this limit.
VULTR_HOURLY_COST_USD=0.471
VULTR_MAX_JOB_COST_USD=5.00
VULTR_MAX_JOB_SECONDS=7200
VULTR_READY_TIMEOUT_SECONDS=1800
VULTR_POLL_SECONDS=15
VULTR_SSH_USER=root

# Required after creating a Vultr Object Storage subscription and private bucket.
# These S3 credentials are different from VULTR_API_KEY.
VULTR_S3_ENDPOINT=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=dapta-adapters

# Optional initially. Useful for model downloads and private adapter mirrors.
HF_TOKEN=
HF_ADAPTER_REPO=

# Added when the ASI:One / Agentverse bridge is implemented.
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=

# Added when Devin implements skill plugins and scoped pipeline repairs.
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Supabase trace for every LoRA-agent prompt and agent output.
# Use the secret key from Project Settings → API. Never put it in the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Added when the backend and observability are deployed.
DATABASE_URL=
REDIS_URL=
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development

# Application-only secrets. Generate fresh random values before deployment.
DAPTA_SECRET_KEY=
DAPTA_ENV=development
DAPTA_LEDGER_PATH=artifacts/dapta-ledger.sqlite3
